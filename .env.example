# Copie para .env (não versionado): pnpm env:criar
# Variáveis da infraestrutura local (compose.yaml). Cada app/serviço tem o próprio .env.

# Postgres (superusuário; cada serviço usa o próprio usuário, ver infra/postgres/init)
POSTGRES_USER=davinci
POSTGRES_PASSWORD=davinci
POSTGRES_PORTA=5550

# RabbitMQ
RABBITMQ_USUARIO=davinci
RABBITMQ_SENHA=davinci
RABBITMQ_PORTA=5551
RABBITMQ_PAINEL_PORTA=5552

# Mailpit (e-mails de desenvolvimento)
SMTP_PORTA=5553
MAILPIT_PORTA=5554
