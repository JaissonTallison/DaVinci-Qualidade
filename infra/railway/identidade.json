{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/docker/servico.Dockerfile",
    "watchPatterns": [
      "/services/identidade/**",
      "/packages/**",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/package.json",
      "/turbo.json",
      "/infra/docker/**",
      "/infra/railway/identidade.json"
    ]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "preDeployCommand": [
      "pnpm --filter @davinci/identidade db:migrate"
    ]
  }
}
