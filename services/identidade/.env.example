# Copie para .env (não versionado). Valores de desenvolvimento local (compose.yaml).
RABBITMQ_URL=amqp://davinci:davinci@localhost:5551
DATABASE_URL=postgresql://svc_identidade:identidade@localhost:5550/davinci_identidade

# Chave privada de assinatura dos tokens (Ed25519, PEM em base64). Gerada por: pnpm identidade:instalar
JWT_CHAVE_PRIVADA=

# Chave de criptografia dos segredos do 2FA (gerada por: pnpm identidade:instalar)
CRIPTOGRAFIA_CHAVE=

# Endereço do sistema (web), usado nos links enviados por e-mail
APP_URL=http://localhost:3170
