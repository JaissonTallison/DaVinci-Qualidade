{
  "name": "@davinci/identidade",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Microsserviço identidade — empresas e filiais (multiempresa), usuários, perfis e permissões; base da autenticação no gateway",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --type-aware src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "instalar": "nest build && node dist/instalar.js",
    "test:integracao": "vitest run --config vitest.config.integracao.ts"
  },
  "dependencies": {
    "@davinci/database": "workspace:*",
    "@davinci/shared": "workspace:*",
    "@davinci/types": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/microservices": "catalog:",
    "amqp-connection-manager": "catalog:",
    "amqplib": "catalog:",
    "drizzle-orm": "catalog:",
    "jose": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@davinci/config": "workspace:*",
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
