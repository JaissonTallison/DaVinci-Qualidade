{
  "name": "@davinci/plataforma",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Microsserviço plataforma — serviços transversais: documentos e anexos, notificações (e-mail, WhatsApp) e trilha de auditoria",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --type-aware src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "node ../../scripts/gerar-migracao.mjs",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@davinci/database": "workspace:*",
    "@davinci/shared": "workspace:*",
    "@davinci/types": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/microservices": "catalog:",
    "amqp-connection-manager": "catalog:",
    "amqplib": "catalog:",
    "drizzle-orm": "catalog:",
    "nodemailer": "^7.0.13",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@davinci/config": "workspace:*",
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
