# Copie para .env (não versionado). Valores de desenvolvimento local (compose.yaml).
RABBITMQ_URL=amqp://davinci:davinci@localhost:5551
DATABASE_URL=postgresql://svc_plataforma:plataforma@localhost:5550/davinci_plataforma

# E-mail (SMTP). Em desenvolvimento: Mailpit do compose (caixa de entrada http://localhost:5554).
# Em produção: o SMTP do provedor (Amazon SES, Brevo, Resend, Google Workspace…).
SMTP_HOST=localhost
SMTP_PORTA=5553
SMTP_SEGURO=false
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=DaVinci Qualidade <nao-responda@davinci.local>
