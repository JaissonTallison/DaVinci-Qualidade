# Copie para .env (não versionado). Valores de desenvolvimento local (compose.yaml).
RABBITMQ_URL=amqp://davinci:davinci@localhost:5551
DATABASE_URL=postgresql://svc_integracoes:integracoes@localhost:5550/davinci_integracoes

# Provedor de NF-e: simulado (padrão, só homologação) ou focus (exige FOCUS_NFE_TOKEN)
NFE_PROVEDOR=simulado
# FOCUS_NFE_TOKEN=
# Cobrança (boleto com Pix): simulado por padrão. Produção: COBRANCA_PROVEDOR=asaas + chave e token do webhook.
# COBRANCA_PROVEDOR=asaas
# ASAAS_CHAVE=
# ASAAS_URL=https://api-sandbox.asaas.com/v3
# ASAAS_TOKEN_WEBHOOK=
# COBRANCA_CONSULTA_MINUTOS=15
