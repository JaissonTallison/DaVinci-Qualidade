# Copie para .env (não versionado). Valores de desenvolvimento local (compose.yaml).
PORT=3171
RABBITMQ_URL=amqp://davinci:davinci@localhost:5551

# Telemetria NestJS Observe (opcional): só liga quando as duas chaves existem.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# Chave pública para conferir os tokens de login (gerada por: pnpm identidade:instalar)
JWT_CHAVE_PUBLICA=
