{
  "name": "@davinci/database",
  "version": "1.0.0",
  "private": true,
  "description": "Acesso ao Postgres para os microsserviços: conexão Drizzle, módulo NestJS, verificação de saúde e migrações",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./teste": {
      "types": "./dist/teste.d.ts",
      "default": "./dist/teste.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --type-aware src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@davinci/types": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "catalog:"
  },
  "peerDependencies": {
    "@nestjs/common": "catalog:"
  },
  "devDependencies": {
    "@davinci/config": "workspace:*",
    "@nestjs/common": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
